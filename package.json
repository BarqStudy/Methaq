    "socket.io": "^4.8.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.0"
  }
}
